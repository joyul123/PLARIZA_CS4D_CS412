            print("Preferred Genre:", selected_genre)
            print(
                "Action: Recommend more "
                + selected_genre
                + " songs."
            )
            print(
                "Reason: You frequently listen to "
                + selected_genre
                + ", so the system recommends more "
                "songs from this genre."
            )


            # Show recommendations

            print("\nRecommended Songs:")

            for song in music[selected_genre]:
                print("🎵", song)

        else:

            print("\nRULE 2 NOT ACTIVATED")
            print("The genre was not recognized.")
            print("Action: Explore different genres.")


