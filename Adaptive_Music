# Get user's information


try:

    skip_rate = float(
        input("\nEnter your song skip rate (0-100%): ")
    )

    genre_choice = input(
        "Enter your preferred genre: "
    ).strip().lower()


    # Convert user's genre input


    genres = {
        "pop": "Pop",
        "k-pop": "K-Pop",
        "kpop": "K-Pop",
        "r&b": "R&B",
        "rnb": "R&B",
        "rock": "Rock"
    }

    selected_genre = genres.get(genre_choice)


    # Check if skip rate is valid


    if skip_rate < 0 or skip_rate > 100:

        print("\nInvalid skip rate.")
        print("Please enter a value between 0 and 100.")

    else:

      
        print("       PERSONALIZED RESULTS")
       
        # RULE 1
        #
        # If the user skips songs frequently
        # → Then recommend shorter songs.
        #
        # We consider 50% or higher as
        # frequent skipping.

        if skip_rate >= 50:

            print("\nRULE 1 ACTIVATED")
            print("You frequently skip songs.")
            print("Action: Recommend shorter songs.")
            print(
                "Reason: You skip many songs, so shorter "
                "tracks may better match your listening behavior."
            )

        else:

            print("\nRULE 1 NOT ACTIVATED")
            print("You do not frequently skip songs.")
            print("Action: You can explore different songs.")

 
        # RULE 2
        #
        # If the user listens to one genre
        # repeatedly
        # → Then recommend more songs
        # from that genre.

        if selected_genre:

